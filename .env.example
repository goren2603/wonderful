DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Optional Talent narrative; numerical analysis works without this.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional real email alerts for Radar (self-serve subscribe on the Radar
# page). Without these, spike alerts are logged but never actually sent.
RESEND_API_KEY=
ALERT_EMAIL_FROM="Wonderful Intelligence <alerts@yourdomain.com>"

# Required only for external cron GET requests (Vercel Cron uses this — see vercel.json). Choose a strong secret for deployment.
CRON_SECRET=

# Optional HTTP Basic auth gate in front of the whole app (see src/middleware.ts).
# Recommended for a link you're sending to someone outside your team.
DEMO_ACCESS_TOKEN=

# Set to 1 only for isolated testing/builds.
DISABLE_SCHEDULER=0
