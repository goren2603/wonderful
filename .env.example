DATABASE_URL="file:./dev.db"

# Optional Talent narrative; numerical analysis works without this.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Reserved: live web research and email delivery adapters are NOT implemented.
SEARCH_PROVIDER_API_KEY=
EMAIL_PROVIDER_API_KEY=

# Required only for external cron GET requests. Choose a strong secret for deployment.
CRON_SECRET=

# Optional HTTP Basic gate; otherwise use upstream Cloudflare Access.
DEMO_ACCESS_TOKEN=

# Set to 1 only for isolated testing/builds.
DISABLE_SCHEDULER=0
