# SQLite by default — zero setup. For production persistence, point this at a
# hosted Postgres URL instead (see README "Deployment").
DATABASE_URL="file:./dev.db"

# Optional. If unset, the app runs in demo mode: a deterministic, clearly-labeled
# fallback provider generates interpretations instead of calling a real model.
ANTHROPIC_API_KEY=

# Optional. If unset, Company Scout / Radar use the built-in demo research
# provider (curated, labeled sample evidence) instead of live web search.
SEARCH_PROVIDER_API_KEY=

# Optional. If unset, outreach emails stay in Draft/Awaiting Approval — nothing
# is ever sent automatically.
EMAIL_PROVIDER_API_KEY=

# Shared secret required to hit /api/agents/run from an external scheduler
# (e.g. Vercel Cron). Set this in production.
CRON_SECRET=dev-secret
